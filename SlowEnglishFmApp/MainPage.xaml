<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SlowEnglishFmApp.ViewModels"
             xmlns:converters="clr-namespace:SlowEnglishFmApp.Converters"
             x:Class="SlowEnglishFmApp.MainPage"
             BackgroundColor="#0E1116"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

        <Style x:Key="KaraokeLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#F5F7FA" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="LineHeight" Value="1.25" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <!--
                NoWrap 是关键：Label 必须按「完整单词宽度」参与排版。
                默认的 WordWrap 在被测宽度受限时会把期望宽度报成接近容器宽度，
                FlexLayout 于是每行只放得下一个词，且超宽部分被直接裁掉
                （现象：while 显示成 whil、limiting 显示成 limitin）。
                NoWrap 后每个词给足自己的宽度，放不下时整词换行，绝不裁字。
            -->
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="Auto, *, Auto" ColumnDefinitions="*">

        <!-- 顶部：台标 + 当前节目 + 在线人数 -->
        <Grid Grid.Row="0" Padding="24,18,24,8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <HorizontalStackLayout Grid.Column="0" Spacing="14" VerticalOptions="Center">
                <Border Padding="10,4" StrokeShape="RoundRectangle 8" BackgroundColor="#B00020" Stroke="Transparent">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FF5252" />
                        <Label Text="ON AIR" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Border>
                <Label Text="{Binding Listeners, StringFormat='&#128266; {0}'}"
                       TextColor="#9AA4B2" FontSize="16" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="2" Margin="0,12,0,0">
                <Label Text="{Binding ProgrammeTitle}"
                       TextColor="White" FontSize="30" FontAttributes="Bold"
                       LineBreakMode="WordWrap" MaxLines="2" />
                <Label Text="{Binding NextTitle, StringFormat='接下来：{0}'}"
                       TextColor="#7E8794" FontSize="16"
                       IsVisible="{Binding NextTitle, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- 中部：卡拉OK 字幕 -->
        <Border Grid.Row="1" Margin="16,4" StrokeShape="RoundRectangle 16"
                Stroke="#1C2530" BackgroundColor="#141A21" Padding="20">
            <ScrollView x:Name="SubtitleScroll">
                <FlexLayout x:Name="WordsHost"
                            BindableLayout.ItemsSource="{Binding CurrentTurnWords}"
                            Wrap="Wrap" JustifyContent="Center" AlignItems="Center" AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:KaraokeWord">
                            <!--
                                高亮只用「颜色/背景」表达，绝不能改 FontSize / FontAttributes / Margin：
                                那会让整句 Label 重新测量、FlexLayout 重新换行，每换一个词就整句重排，
                                是滚动与高亮卡顿的主因（词还会因此跳行）。
                            -->
                            <Label Style="{StaticResource KaraokeLabel}" Text="{Binding Text}"
                                   FlexLayout.Shrink="0">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPast}" Value="True">
                                        <Setter Property="TextColor" Value="#5B6675" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="TextColor" Value="#0E1116" />
                                        <Setter Property="BackgroundColor" Value="#FFC83D" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
        </Border>

        <!-- 底部：状态 / 播放控制 -->
        <Grid Grid.Row="2" Padding="24,10,24,24" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
            <Label Grid.Row="0" Text="{Binding StatusMessage}"
                   TextColor="#9AA4B2" FontSize="16" HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Grid.Row="1" Command="{Binding TogglePlayCommand}"
                    FontSize="28" FontAttributes="Bold"
                    HeightRequest="84" CornerRadius="42" Margin="0,6"
                    BackgroundColor="#1F6FEB" TextColor="White">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPlaying}" Value="False">
                        <Setter Property="Text" Value="&#9654;  播放" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPlaying}" Value="True">
                        <Setter Property="Text" Value="&#9209;  停止" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</ContentPage>
