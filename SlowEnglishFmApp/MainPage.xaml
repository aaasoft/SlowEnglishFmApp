<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SlowEnglishFmApp.ViewModels"
             xmlns:converters="clr-namespace:SlowEnglishFmApp.Converters"
             x:Class="SlowEnglishFmApp.MainPage"
             BackgroundColor="#0E1116"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

        <Style x:Key="KaraokeLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#F5F7FA" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="LineHeight" Value="1.15" />
            <!--
                单词之间的视觉空隙 = 相邻两个词的 (Margin + Padding) 之和。
                原来是 6 + 10 = 16（左右各一份，合计 32dp），词间像被拉开一样松散；
                现在 1 + 6 = 7（合计 14dp），接近英文正常词距（约 0.25em），更像正常排版。
                注意：Padding 同时决定高亮背景块的内边距，横向不宜小于 5，
                否则色块会贴住字母显得拥挤。
            -->
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <!--
                NoWrap 是关键：Label 必须按「完整单词宽度」参与排版。
                默认的 WordWrap 在被测宽度受限时会把期望宽度报成接近容器宽度，
                FlexLayout 于是每行只放得下一个词，且超宽部分被直接裁掉
                （现象：while 显示成 whil、limiting 显示成 limitin）。
                NoWrap 后每个词给足自己的宽度，放不下时整词换行，绝不裁字。
            -->
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="Auto, *, Auto" ColumnDefinitions="*">

        <!-- 顶部：台标 + 当前节目 + 在线人数（右侧留位给横屏的圆形播放/停止按钮） -->
        <Grid x:Name="TopPanel" Grid.Row="0" Padding="24,18,24,8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <HorizontalStackLayout Grid.Column="0" Spacing="14" VerticalOptions="Center">
                <Border x:Name="OnAirBadge" Padding="10,4" StrokeShape="RoundRectangle 8" BackgroundColor="#B00020" Stroke="Transparent">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FF5252" />
                        <Label x:Name="OnAirLabel" Text="ON AIR" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Border>
                <HorizontalStackLayout x:Name="ListenersPanel" Spacing="6" VerticalOptions="Center">
                    <!--
                        「在线听众」图标：自绘的单色人形剪影（头 + 肩）。
                        原来用的是 🔊 emoji——语义是「音频/音量」，且 Android 会渲染成彩色 emoji，
                        各设备样式不一致；自绘图形颜色可跟随主题、也不受字体影响。
                    -->
                    <VerticalStackLayout x:Name="ListenersIcon" Spacing="1" VerticalOptions="Center">
                        <Ellipse WidthRequest="7" HeightRequest="7" Fill="#9AA4B2" HorizontalOptions="Center" />
                        <Path Data="M0,8 A8,8 0 0 1 16,8 Z" Fill="#9AA4B2" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Label x:Name="ListenersLabel" Text="{Binding Listeners}"
                           TextColor="#9AA4B2" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="TitlePanel" Grid.Column="0" Grid.Row="1" Spacing="2" Margin="0,12,0,0">
                <Label x:Name="ProgrammeLabel" Text="{Binding ProgrammeTitle}"
                       TextColor="White" FontSize="30" FontAttributes="Bold"
                       LineBreakMode="WordWrap" MaxLines="2" />
                <Label x:Name="NextLabel" Text="{Binding NextTitle, StringFormat='接下来：{0}'}"
                       TextColor="#7E8794" FontSize="16"
                       IsVisible="{Binding NextTitle, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>

            <!--
                横屏专用：右上角圆形播放/停止按钮。
                横屏高度紧张，把控制按钮挪到顶部台标右侧，底部就能整块让给字幕。
                竖屏仍用底部的大号按钮（本控件在竖屏下隐藏）。
                图标用 Path / BoxView 绘制：emoji 字符（▶ / ⏹）在 Android 上会被渲染成彩色
                方形emoji，放进圆形按钮里很难看。
            -->
            <Border x:Name="CompactPlayButton" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                    IsVisible="False"
                    WidthRequest="64" HeightRequest="64"
                    StrokeShape="RoundRectangle 32" Stroke="Transparent"
                    BackgroundColor="#1F6FEB"
                    HorizontalOptions="End" VerticalOptions="Center"
                    Margin="12,0,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePlayCommand}" />
                </Border.GestureRecognizers>
                <Grid>
                    <Path Data="M 0,0 L 0,30 L 25,15 Z" Fill="White" Stroke="Transparent"
                          HorizontalOptions="Center" VerticalOptions="Center">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>
                    <BoxView WidthRequest="22" HeightRequest="22" CornerRadius="3" Color="White"
                             IsVisible="False"
                             HorizontalOptions="Center" VerticalOptions="Center">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                </Grid>
            </Border>
        </Grid>

        <!-- 中部：卡拉OK 字幕 -->
        <Border x:Name="SubtitleBorder" Grid.Row="1" Margin="16,4" StrokeShape="RoundRectangle 16"
                Stroke="#1C2530" BackgroundColor="#141A21" Padding="20"
                MinimumHeightRequest="96">
            <ScrollView x:Name="SubtitleScroll" Orientation="Vertical" VerticalScrollBarVisibility="Never">
                <!--
                    外面套一层 Grid：把 FlexLayout 的可用宽度钉死为视口宽度。
                    直接把 FlexLayout 作为 ScrollView 内容时，横竖屏切换后宽度约束可能失真，
                    整句会排成一行并横向溢出被裁掉（现象：文字左右两边都被切）。
                -->
                <Grid HorizontalOptions="Fill" VerticalOptions="Start">
                    <FlexLayout x:Name="WordsHost"
                                BindableLayout.ItemsSource="{Binding CurrentTurnWords}"
                                Wrap="Wrap" JustifyContent="Center" AlignItems="Center" AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:KaraokeWord">
                                <!--
                                    高亮只用「颜色/背景」表达，绝不能改 FontSize / FontAttributes / Margin：
                                    那会让整句 Label 重新测量、FlexLayout 重新换行，每换一个词就整句重排，
                                    是滚动与高亮卡顿的主因（词还会因此跳行）。
                                -->
                                <Label Style="{StaticResource KaraokeLabel}" Text="{Binding Text}"
                                       FlexLayout.Shrink="0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPast}" Value="True">
                                            <Setter Property="TextColor" Value="#5B6675" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor" Value="#0E1116" />
                                            <Setter Property="BackgroundColor" Value="#FFC83D" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Grid>
            </ScrollView>
        </Border>

        <!-- 底部：状态 / 播放控制 -->
        <Grid x:Name="BottomPanel" Grid.Row="2" Padding="24,10,24,24" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
            <Label x:Name="StatusLabel" Grid.Row="0" Text="{Binding StatusMessage}"
                   TextColor="#9AA4B2" FontSize="16" HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button x:Name="PlayButton" Grid.Row="1" Command="{Binding TogglePlayCommand}"
                    FontSize="28" FontAttributes="Bold"
                    HeightRequest="84" CornerRadius="42" Margin="0,6"
                    BackgroundColor="#1F6FEB" TextColor="White">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPlaying}" Value="False">
                        <Setter Property="Text" Value="&#9654;  播放" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPlaying}" Value="True">
                        <Setter Property="Text" Value="&#9209;  停止" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</ContentPage>
