<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorPrimary">#512BD4</color>
    <!--
        colorPrimaryDark 是模板留下的状态栏色：AppCompat 主题默认拿它当 android:statusBarColor，
        MIUI 更是直接读它给状态栏着色（本机实测：显式设 statusBarColor 无效，状态栏像素与本值逐字节相同）。
        改成页面底色 #0E1116，让系统状态栏与 App 界面无缝。colorPrimary 保留原品牌紫（仅影响默认控件着色）。
    -->
    <color name="colorPrimaryDark">#0E1116</color>
    <color name="colorAccent">#2B0B98</color>
</resources>